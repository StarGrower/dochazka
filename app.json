{
  "expo": {
    "name": "Docházka",
    "slug": "Dochazka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dochazka",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cz.kalensky.dochazka"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#131311"
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Docházka potřebuje vědět, kde jste, aby mohla automaticky rozpoznat příjezd na uložená místa (stavby, rybníky) a navrhnout odpracovaný čas.",
          "locationAlwaysAndWhenInUsePermission": "Docházka potřebuje sledovat polohu i na pozadí, aby zaznamenala pobyty na stavbách, i když appku nemáte otevřenou. Bez toho nejde zapsat docházku automaticky.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-maps",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
